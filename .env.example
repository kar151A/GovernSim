# Run python scripts/bootstrap.py to generate real local credentials.
# Keys map SHA-256(token) to an authenticated name and role. No built-in tokens.
GOVERNSIM_API_KEYS={}
POSTGRES_PASSWORD=
SEED_DEMO=true
LLM_PROVIDER=offline
# Optional: provider=openai or anthropic; LLM_MODEL must be an available model ID.
# LLM_API_KEY=
# LLM_MODEL=
# Optional local override (Compose supplies PostgreSQL automatically):
# DATABASE_URL=sqlite:///./governsim.db
