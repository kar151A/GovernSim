# Configuration reference only: run python scripts/bootstrap.py for local setup.
# Do not copy this template over a generated .env. Bootstrap preserves existing files.
# Optional legacy automation only. Website accounts always use password + 2FA.
# Keep disabled to prevent bearer tokens bypassing MFA. No built-in tokens.
GOVERNSIM_API_KEYS={}
GOVERNSIM_ALLOW_LEGACY_API_KEYS=false
# Bootstrap adds a random GOVERNSIM_AUTH_KEY; never commit the actual value.
# GOVERNSIM_AUTH_KEY=
# Use true behind HTTPS when hosting; false is for loopback development only.
GOVERNSIM_AUTH_COOKIE_SECURE=false
GOVERNSIM_AUTH_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# Run scripts/configure_email.py locally; it prompts for SMTP credentials privately.
# Required for website email verification and Forgot password. Never use VITE_ here.
GOVERNSIM_SMTP_HOST=
GOVERNSIM_SMTP_PORT=465
GOVERNSIM_SMTP_SECURITY=ssl
GOVERNSIM_SMTP_USERNAME=
GOVERNSIM_SMTP_PASSWORD=
GOVERNSIM_SMTP_FROM=
# Compose requires a nonempty password; bootstrap generates a URL-safe value.
POSTGRES_PASSWORD=
# Synthetic demo fixtures only. Set false for a clean non-demo deployment.
SEED_DEMO=true
LLM_PROVIDER=offline
# Optional: provider=openai or anthropic; LLM_MODEL must be an available model ID.
# LLM_API_KEY=
# LLM_MODEL=
# Optional local override (Compose supplies PostgreSQL automatically):
# DATABASE_URL=sqlite:///./governsim.db
