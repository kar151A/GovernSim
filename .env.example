# Configuration reference only: run python scripts/bootstrap.py for local setup.
# Do not copy this template over a generated .env. Bootstrap preserves existing files.
# Keys map SHA-256(token) to an authenticated name and role. No built-in tokens.
# An empty mapping deliberately prevents API startup. Never put plaintext tokens here.
GOVERNSIM_API_KEYS={}
# Compose requires a nonempty password; bootstrap generates a URL-safe value.
POSTGRES_PASSWORD=
# Synthetic demo fixtures only. Set false for a clean non-demo deployment.
SEED_DEMO=true
LLM_PROVIDER=offline
# Optional: provider=openai or anthropic; LLM_MODEL must be an available model ID.
# LLM_API_KEY=
# LLM_MODEL=
# Optional local override (Compose supplies PostgreSQL automatically):
# DATABASE_URL=sqlite:///./governsim.db
